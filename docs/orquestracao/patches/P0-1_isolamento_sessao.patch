+++ b/src/lib/sessionCleanup.ts
@@ -0,0 +1,63 @@
+/**
+ * Isolamento de sessão em dispositivo compartilhado (P0-1).
+ *
+ * O PrescriMed guarda dados clínicos e de configuração no localStorage
+ * (rascunhos de AIH/notificação, histórico de emissões, cabeçalho da
+ * clínica, assinatura etc.). Em PC compartilhado de plantão, esses dados
+ * não podem sobreviver à troca de usuário.
+ *
+ * Regras:
+ *  - NÃO toca nas chaves do Supabase Auth (sb-*): o signOut cuida delas.
+ *  - Preferências de UI sem dado clínico ficam em KEEP_KEYS.
+ */
+const OWNER_KEY = "prescrimed:session-owner";
+
+const APP_KEY_PREFIXES = ["prescrimed", "protocolo-sessao:"];
+
+const APP_KEYS_EXACT = new Set([
+  "protocolos_recentes",
+  "clinic-info",
+  "signature-config",
+  "custom-medications",
+  "custom-templates",
+]);
+
+const KEEP_KEYS = new Set(["prescrimed:install-banner-dismissed"]);
+
+export function isAppDataKey(key: string): boolean {
+  if (KEEP_KEYS.has(key)) return false;
+  if (APP_KEYS_EXACT.has(key)) return true;
+  return APP_KEY_PREFIXES.some((prefix) => key.startsWith(prefix));
+}
+
+/** Remove todos os dados locais do app (inclui o marcador de dono). */
+export function clearLocalAppData(): void {
+  try {
+    const keys: string[] = [];
+    for (let i = 0; i < localStorage.length; i++) {
+      const key = localStorage.key(i);
+      if (key && isAppDataKey(key)) keys.push(key);
+    }
+    keys.forEach((key) => localStorage.removeItem(key));
+  } catch {
+    // storage indisponível: nunca bloquear o fluxo de auth
+  }
+}
+
+/**
+ * Garante que os dados locais pertencem ao usuário autenticado.
+ * Se o dono registrado for outro (ou não houver dono registrado),
+ * limpa tudo e registra o novo dono. Retorna true se limpou.
+ * Cobre o caso "médico A fechou a aba sem sair e médico B entrou".
+ */
+export function ensureLocalDataOwner(userId: string): boolean {
+  try {
+    const owner = localStorage.getItem(OWNER_KEY);
+    if (owner === userId) return false;
+    clearLocalAppData();
+    localStorage.setItem(OWNER_KEY, userId);
+    return true;
+  } catch {
+    return false;
+  }
+}
